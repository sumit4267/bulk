# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── SMTP Provider ────────────────────────────────────────────
# One of: gmail | outlook | custom
SMTP_PROVIDER=gmail

# ── Gmail (use an App Password, NOT your normal password) ───
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Outlook / Office365 ──────────────────────────────────────
OUTLOOK_USER=you@outlook.com
OUTLOOK_APP_PASSWORD=your-app-password

# ── Custom SMTP (any provider: Zoho, SES, SendGrid SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=your-password

# ── Sending behaviour ────────────────────────────────────────
# Delay between each email (ms) — keeps you under provider rate limits
# and makes sends look human/organic rather than automated.
SEND_DELAY_MS=3000

# Max recipients allowed in a single campaign
MAX_RECIPIENTS=1000

# Max resume file size in MB
MAX_FILE_SIZE_MB=5
